{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osco.dev/schema/capability.schema.json",
  "title": "OSCO Capability",
  "type": "object",
  "required": [
    "capability_id",
    "stable_id",
    "name",
    "description",
    "category",
    "domain",
    "platforms"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "stable_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "domain": { "type": "string" },
    "platforms": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "providers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "safety": { "type": "string", "enum": ["safe", "caution", "destructive"] },
    "required_privileges": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["framework", "external_id", "external_name"],
        "properties": {
          "framework": { "type": "string" },
          "external_id": { "type": "string" },
          "external_name": { "type": "string" },
          "relation": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "url": { "type": "string" }
        }
      }
    }
  }
}
